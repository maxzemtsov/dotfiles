# PostHog operator CLI — local config.
#
# Copy this file to:  ~/.config/posthog-cli-skill/config.env
# then fill in YOUR 1Password coordinates. This file holds NO secret values —
# only the *names* of your vault / item / field and non-secret ids. The actual
# PostHog personal API key (phx_...) is fetched from 1Password at runtime via `op`.
#
# For credentials and secrets, use the /op-secrets skill. NEVER paste keys in chat
# or commit them to a repo.

# --- 1Password service-account token -------------------------------------------
# Name of the env var in your shell that holds your 1Password SA token.
# Leave as OP_SERVICE_ACCOUNT_TOKEN if that's already exported; or point it at a
# project-scoped token var, e.g. OP_SA_MYPROJECT.
export PH_OP_TOKEN_ENV="OP_SERVICE_ACCOUNT_TOKEN"

# --- where your PostHog PERSONAL API key (phx_...) lives in 1Password ----------
export PH_OP_VAULT="YourVault"
export PH_OP_ITEM="PostHog"
export PH_OP_FIELD="Personal API Key"     # the field label holding the phx_ key

# --- PostHog project + host (NOT secret) ---------------------------------------
export POSTHOG_CLI_PROJECT_ID="00000"
export POSTHOG_CLI_HOST="https://us.posthog.com"   # or https://eu.posthog.com
